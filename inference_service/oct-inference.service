[Unit]
Description=OCT Multi-Task Inference Service (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
# Adjust User and paths to your deployment. Runs bound to localhost only.
User=www-data
WorkingDirectory=/opt/octina/inference_service
Environment=WEIGHTS_PATH=/opt/octina/inference_service/weights/best_model.pt
Environment=DEVICE=cpu
ExecStart=/opt/octina/inference_service/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
